FROM node:22-alpine AS build
WORKDIR /app
COPY web/saas-dashboard/package*.json ./
RUN npm ci
COPY web/saas-dashboard/ ./
ARG VITE_API_BASE_URL=
ARG VITE_APP_VERSION=7.4.0
ARG VITE_GIT_COMMIT=unknown
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_APP_VERSION=$VITE_APP_VERSION VITE_GIT_COMMIT=$VITE_GIT_COMMIT
RUN npm run build

FROM nginx:alpine
ENV SAAS_API_UPSTREAM=http://saas-api:8000
ENV NGINX_ENVSUBST_FILTER=^SAAS_API_UPSTREAM$
COPY deploy/nginx/saas.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
