# ============================================================
# SaaS production environment example
# Copy to .env.production and keep the real file out of git.
# ============================================================

# ------------------------------------------------------------
# 1. Runtime mode
# ------------------------------------------------------------
# browser-use: run API, worker, Chromium, noVNC, and automation in Linux Docker.
# control-plane-only: API only; browser automation endpoints are unavailable.
SAAS_ENV=production
SAAS_DEPLOYMENT_MODE=browser-use

# ------------------------------------------------------------
# 2. PostgreSQL
# ------------------------------------------------------------
# Use the Docker service host `postgres` inside docker compose.
POSTGRES_DB=facebook_leads_saas
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=replace-with-a-strong-password
SAAS_DATABASE_URL=postgresql+psycopg://saas_user:replace-with-a-strong-password@postgres:5432/facebook_leads_saas

# ------------------------------------------------------------
# 3. HTTP, session, and security
# ------------------------------------------------------------
# SESSION_SECRET must be at least 32 characters in production.
# SAAS_ALLOWED_ORIGINS is a comma-separated allowlist. Do not use *.
SESSION_SECRET=replace-with-at-least-32-random-characters
SAAS_ALLOWED_ORIGINS=https://leads.example.com
SAAS_COOKIE_SECURE=true
SAAS_TRUST_PROXY=false

# ------------------------------------------------------------
# 4. Database pool
# ------------------------------------------------------------
SAAS_DB_POOL_SIZE=10
SAAS_DB_MAX_OVERFLOW=20
SAAS_DB_POOL_RECYCLE=1800

# ------------------------------------------------------------
# 5. Browser runtime and noVNC
# ------------------------------------------------------------
# Profiles must be persisted. In Docker this maps to browser_profiles:/data/browser_profiles.
# CDP ports are container-local; no frontend/client should use them directly.
SAAS_RUNTIME_HOST=local
SAAS_BROWSER_PROFILE_ROOT=/data/browser_profiles
SAAS_BROWSER_CDP_PORT_START=9300
SAAS_BROWSER_CDP_PORT_END=9399
SAAS_BROWSER_HEADLESS=false
SAAS_ENABLE_NOVNC=true
SAAS_NOVNC_PORT=6080
DISPLAY=:99
SAAS_BROWSER_IDLE_TIMEOUT_MINUTES=30

# ------------------------------------------------------------
# 6. Worker, queue, and scheduler
# ------------------------------------------------------------
# Current production compose runs worker inside the saas-api container so it can reach
# the container-local browser CDP endpoint.
SAAS_WORKER_CONCURRENCY=1
SAAS_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
SAAS_MAX_QUEUED_EXECUTIONS_PER_TENANT=50
SAAS_SCHEDULER_QUEUE_FULL_RETRY_MINUTES=5
SAAS_HEARTBEAT_STALE_SECONDS=60
SAAS_QUEUE_STALE_SECONDS=21600

# ------------------------------------------------------------
# 7. Sessions and retention
# ------------------------------------------------------------
SAAS_SESSION_TTL_HOURS=168
SAAS_SESSION_IDLE_TIMEOUT_HOURS=24
SAAS_EXECUTION_RETENTION_DAYS=90
SAAS_ARTIFACT_RETENTION_DAYS=30

# ------------------------------------------------------------
# 8. Bootstrap and demo seed
# ------------------------------------------------------------
# Bootstrap admin is only used when the users table is empty.
# Remove SAAS_BOOTSTRAP_ADMIN_PASSWORD after first successful startup.
SAAS_ENABLE_DEMO_SEED=false
SAAS_BOOTSTRAP_ADMIN_EMAIL=
SAAS_BOOTSTRAP_ADMIN_PASSWORD=
SAAS_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ------------------------------------------------------------
# 9. LLM review
# ------------------------------------------------------------
# Required for campaigns with llm_enabled=true and lead_detection_mode=rules_with_llm.
# SAAS_LLM_ENDPOINT must be OpenAI-compatible, e.g. https://api.openai.com/v1.
SAAS_LLM_ENDPOINT=
SAAS_LLM_MODEL=gpt-5.5
OPENAI_API_KEY=
SAAS_LLM_INPUT_COST_PER_1M=
SAAS_LLM_OUTPUT_COST_PER_1M=

# Compatibility for the lower-level Facebook leads runner.
# Keep this equal to SAAS_LLM_MODEL unless you intentionally override the runner.
FACEBOOK_LEADS_LLM_MODEL=gpt-5.5

# ------------------------------------------------------------
# 10. Artifact storage: local volume or remote MinIO/S3
# ------------------------------------------------------------
# false: keep artifacts in Docker volume saas_artifacts:/app/artifacts/saas.
# true: upload execution_report.html/json and raw artifacts to a remote S3-compatible service.
SAAS_ARTIFACT_S3_ENABLED=false
SAAS_ARTIFACT_S3_ENDPOINT=https://minio.example.com
SAAS_ARTIFACT_S3_ACCESS_KEY=
SAAS_ARTIFACT_S3_SECRET_KEY=
SAAS_ARTIFACT_S3_BUCKET=facebook-leads-artifacts
SAAS_ARTIFACT_S3_REGION=us-east-1
SAAS_ARTIFACT_S3_PREFIX=saas-artifacts
SAAS_ARTIFACT_S3_PUBLIC_BASE_URL=
SAAS_ARTIFACT_S3_SECURE=true

# ------------------------------------------------------------
# 11. Frontend build/runtime bridge
# ------------------------------------------------------------
# Empty means frontend proxies /api to the compose service upstream.
VITE_API_BASE_URL=

# ------------------------------------------------------------
# 12. Logging and build metadata
# ------------------------------------------------------------
LOG_LEVEL=INFO
APP_VERSION=7.6.0
GIT_COMMIT=unknown
BUILD_TIME=unknown
