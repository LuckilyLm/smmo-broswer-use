SAAS_ENV=production
SAAS_DEPLOYMENT_MODE=windows-local
SAAS_RUNTIME_HOST=local

SAAS_DATABASE_URL=postgresql+psycopg://saas_user:replace-with-a-strong-password@postgres:5432/facebook_leads_saas
DATABASE_URL=postgresql+psycopg://saas_user:replace-with-a-strong-password@127.0.0.1:5432/facebook_leads_saas
SESSION_SECRET=
SAAS_ALLOWED_ORIGINS=http://127.0.0.1:8080
SAAS_COOKIE_SECURE=false
SAAS_TRUST_PROXY=false

SAAS_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# Replace <username> with the Windows account that will run the worker.
SAAS_BROWSER_PROFILE_ROOT=C:\Users\<username>\AppData\Local\browser-use-webui\browser_profiles
SAAS_BROWSER_CDP_PORT_START=9400
SAAS_BROWSER_CDP_PORT_END=9499
SAAS_BROWSER_IDLE_TIMEOUT_MINUTES=30

SAAS_DB_POOL_SIZE=10
SAAS_DB_MAX_OVERFLOW=20
SAAS_DB_POOL_RECYCLE=1800
SAAS_WORKER_CONCURRENCY=1
SAAS_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
SAAS_MAX_QUEUED_EXECUTIONS_PER_TENANT=50
SAAS_SCHEDULER_QUEUE_FULL_RETRY_MINUTES=5
SAAS_HEARTBEAT_STALE_SECONDS=60
SAAS_QUEUE_STALE_SECONDS=21600
SAAS_SESSION_TTL_HOURS=168
SAAS_SESSION_IDLE_TIMEOUT_HOURS=24

OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=
FACEBOOK_LEADS_LLM_MODEL=gpt-5.5
LOG_LEVEL=INFO
