FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.saas.txt ./
RUN pip install --no-cache-dir -r requirements.saas.txt
COPY . .
RUN useradd --create-home --uid 10001 saas && mkdir -p /data/browser_profiles /app/artifacts && chown -R saas:saas /data /app/artifacts
USER saas
CMD ["uvicorn", "src.facebook_leads.saas.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
